<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="0" packages="com.cathaybk.springbootmongodb.config">

    <Properties>
        <Property name="APP_NAME">SpringBoot-MongoDB</Property>
        <Property name="log-path">logs</Property>
        <Property name="log-pattern">[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %c{1} - %msg%n</Property>
        <Property name="console-log-pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{[%thread] %-5level} %style{%logger{36}}{cyan} - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- Console Appender -->
        <Console name="My_Console_Appender" target="SYSTEM_OUT">
            <PatternLayout pattern="${console-log-pattern}"/>
        </Console>

        <!-- RollingFile Appender -->
        <RollingFile name="My_RollingFile_Appender"
                     fileName="${log-path}/${APP_NAME}.log"
                     filePattern="${log-path}/${APP_NAME}.%d{yyyy-MM-dd HHmm}-%i.log.gz">
            <PatternLayout pattern="${log-pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="3MB"/>
            </Policies>
        </RollingFile>

        <!-- MongoDB Appender - 使用自定義的 CustomMongoDbAppender -->
        <CustomMongoDb name="My_MongoDB_Appender"
                       connectionString="mongodb://myDbUser:myDbUser@localhost:27017/myshinynewdb?authSource=myshinynewdb"
                       databaseName="myshinynewdb"
                       collectionName="application_logs">
            <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
        </CustomMongoDb>
    </Appenders>

    <Loggers>
        <Root level="WARN">
            <AppenderRef ref="My_Console_Appender"/>
            <AppenderRef ref="My_MongoDB_Appender"/>
        </Root>

        <Logger name="com.cathaybk" level="INFO" additivity="false">
            <AppenderRef ref="My_Console_Appender" level="INFO"/>
            <AppenderRef ref="My_RollingFile_Appender" level="INFO"/>
            <AppenderRef ref="My_MongoDB_Appender" level="INFO"/>
        </Logger>
    </Loggers>

</Configuration>
